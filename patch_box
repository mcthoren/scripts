#!/bin/sh

# this is meant to be run from cron.

echo -n "$0[$$]: checking for patches..."

restart_daemons() {

	echo "$0[$$]: patches detected"

	CR_OUT="$(mktemp)"

	[ -n "${CR_OUT}" ] || {
		echo "mktemp failed."
		exit 1
	}

	/usr/local/sbin/checkrestart > "${CR_OUT}"

	[ -s "${CR_OUT}" ] || {
		rm "${CR_OUT}"
		return 0
	}

	echo "$0[$$]: restarting daemons "

	for _proc in sshd httpd unwind nsd unbound ntpd; do
		grep "${_proc}" "${CR_OUT}" && rcctl restart "${_proc}"
	done

	# if we restart smtpd at the same time, we don't the mail :x
	grep smptd "${CR_OUT}" && echo "/usr/sbin/rcctl restart smtpd" | \
		/usr/bin/at now +1 min

	rm "${CR_OUT}"
}

SP_OUT="$(/usr/sbin/syspatch 2>&1 )" && [ ! -z "${SP_OUT}" ] && {
	echo
	echo "${SP_OUT}"
	restart_daemons
}

[ -z "${SP_OUT}" ] && echo " no patches found."
